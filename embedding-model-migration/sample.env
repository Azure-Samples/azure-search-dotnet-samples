# Baseline backup/restore
AZURE_AUTH_MODE=cli
# AZURE_CLIENT_ID=<managed-identity-client-id>
SOURCE_SEARCH_ENDPOINT=https://<source-search-service>.search.windows.net
SOURCE_INDEX_NAME=<source-index-name>
TARGET_SEARCH_ENDPOINT=https://<target-search-service>.search.windows.net
TARGET_INDEX_NAME=<new-target-index-name>
SEARCH_API_VERSION=<api-version-covering-source-schema>
BACKUP_DIRECTORY=<absolute-path-to-new-empty-backup-directory>

# Migration
MIGRATION_DIRECTORY=<absolute-path-to-new-empty-migration-directory>
TEXT_FIELD=<existing-top-level-text-field>
VECTOR_FIELD=<existing-top-level-vector-field>
MODEL_VARIANT=fast
VECTOR_DIMENSIONS=<deployment-output-dimensions>
EMBEDDING_BATCH_SIZE=4
FUNCTION_HTTP_TIMEOUT_SECONDS=240
FUNCTION_BASE_ENDPOINT=https://<function-app>.azurewebsites.net
FUNCTION_AUTH_RESOURCE_ID=api://<function-entra-app-client-id>
# SEARCH_FUNCTION_IDENTITY_RESOURCE_ID=/subscriptions/<sub>/resourceGroups/<rg>/providers/Microsoft.ManagedIdentity/userAssignedIdentities/<name>

# In-place additive migration (same index)
SEARCH_ENDPOINT=https://<search-service>.search.windows.net
INDEX_NAME=<existing-index-name>
TEXT_FIELD=<existing-top-level-text-field>
SOURCE_VECTOR_FIELD=<existing-top-level-vector-field>
NEW_VECTOR_FIELD=<new-top-level-vector-field>
QUERY_PROBE_TEXT=How do I recover my account?
# Optional: marker-based idempotent backfill for dual-write cutovers.
# MIGRATION_MARKER_FIELD=migrationVectorVersion
# MIGRATION_MARKER_VALUE=vector_fast_v2:fast:1024
